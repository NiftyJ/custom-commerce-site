# Copy this file to .env for local development and fill in the values.
# .env is ignored by git and is never uploaded. For the live site, add the same names
# in Vercel → Project → Settings → Environment Variables (tick "Sensitive").
# Never put any of these in public/ — everything in that folder is sent to visitors' browsers.

# --- Database (Upstash Redis) ---
# Added for you when you connect Upstash under Vercel → Storage. For local use, copy them
# from the Upstash console (REST API section) or run `vercel env pull .env`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- WhatsApp Business Cloud API (Meta) ---
# Leave blank to run in "dry run" mode: messages are only written to the server log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: WHATSAPP_API_VERSION=v25.0, WHATSAPP_TEMPLATE_LANG=en, DEFAULT_COUNTRY_CODE=233

# --- Reminders ---
# Any long random string. Vercel Cron sends it so only Vercel can trigger the reminder job.
CRON_SECRET=

# --- Site ---
# Public address used in links sent on WhatsApp, e.g. https://custom-commerce-site.vercel.app
SITE_URL=
# Optional: BRAND=Nearbook, CURRENCY=GHS, DEPOSIT_PERCENT=30
